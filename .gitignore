# Everything under assets/ is generated by the host at first run (PNGs, JSON
# maps, WAV) — except the hand-written GLSL sources and the shipped sprite art,
# which are source files and must stay in git: the CC0 packs (brawler, shmup),
# the AI-illustrated art (art, vn) and the committed sheets the city, rts,
# contra and snooker demos load instead of falling back to host painters.
assets/*
!assets/*.vert
!assets/*.frag
# Art-backed sheets that live at the assets/ root because the host's generated
# Tiled maps reference them by name. tools/art_key.py bakes each one from AI
# key art; the host painters still only run when the file is absent.
!assets/m_tiles.png
!assets/p_tiles.png
!assets/s_tiles.png
!assets/arcade/
!assets/arcade/**
!assets/art/
!assets/art/**
!assets/limbo/
!assets/limbo/**
!assets/brawler/
!assets/brawler/**
!assets/city/
!assets/city/**
!assets/contra/
!assets/contra/**
!assets/rts/
!assets/rts/**
!assets/shmup/
!assets/shmup/**
!assets/snooker/
!assets/snooker/**
!assets/vn/
!assets/vn/**
build/
build-nofakelua/
.trae/
.workbuddy/
saves/
dist/

# Python test tooling bytecode
__pycache__/
*.pyc

# Finder metadata (re-ignore inside the un-ignored asset folder too)
**/.DS_Store

# Raw ImageGen output kept locally for reproducible bakes
vibe_images/
